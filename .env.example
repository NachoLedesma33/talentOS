APP_ENV=local
APP_NAME=TalentOS
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/talentos
REDIS_URL=redis://localhost:6379/0

AUTH_SECRET=
# Solo local/test: habilita el seed del usuario superadmin de demo; nunca valor real.
TALENTOS_SUPERADMIN_PASSWORD=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Modo local opcional (ADR-021), sin credenciales y con pesos fuera del repo:
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:4b
# LLM_TIMEOUT_SECONDS=180

# Fernet de 32 bytes en base64 url-safe; generar una clave por despliegue.
INTEGRATION_ENCRYPTION_KEY=

LOG_LEVEL=INFO
AGENT_EVENT_RETENTION_DAYS=30
